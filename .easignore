# --- MOBILE PROJECT IGNORES ---
# We ONLY want the mobile project files to be uploaded.
# Below, we ignore the heavy generated folders inside mobile.
/mobile/node_modules/
/mobile/.expo/
/mobile/android/
/mobile/ios/
/mobile/dist/
/mobile/*.apk
/mobile/*.aab
/mobile/*.jks
/mobile/*.keystore
/mobile/.env*.local
