# Web & Root dependencies (to hide from EAS)
/node_modules/
/package.json
/package-lock.json
/.npm/

# Next.js & Web folders
/.next/
/out/
/src/
/public/
/docs/
/prisma/
/scripts/
/assets/
/android/
/ios/

# Web configs
/next.config.ts
/tsconfig.json
/tsconfig.tsbuildinfo
/eslint.config.mjs
/postcss.config.mjs
/capacitor.config.ts

# Misc
/.idea/
/.vscode/
*.db
*.db-journal
*.log*
