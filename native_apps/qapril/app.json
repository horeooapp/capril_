{
  "expo": {
    "name": "QAPRIL",
    "slug": "proprietaire",
    "version": "2.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2A44"
    },
    "scheme": "qapril",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/edbe7064-bfd4-4162-99a6-d2c731f1f959",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ci.qapril.proprietaire",
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F2A44"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 39
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser $(PRODUCT_NAME) à accéder à vos photos pour la numérisation de vos documents.",
          "cameraPermission": "Autoriser $(PRODUCT_NAME) à utiliser l'appareil photo pour la capture des pièces et constats."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à accéder à la position précise pour la certification de vos biens et attestations."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) à utiliser la biométrie pour une connexion sécurisée."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edbe7064-bfd4-4162-99a6-d2c731f1f959"
      }
    },
    "owner": "qapril"
  }
}
