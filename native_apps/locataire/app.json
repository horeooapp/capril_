{
  "expo": {
    "name": "Qapril-Locataires",
    "slug": "locataire",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8601A"
    },
    "scheme": "qaprillocataire",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/380035ec-a5b8-429b-9864-f4fc6646a77c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ci.qapril.locataire",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001C29"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 19
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser $(PRODUCT_NAME) à accéder à vos photos pour la numérisation de vos documents d'identité.",
          "cameraPermission": "Autoriser $(PRODUCT_NAME) à utiliser l'appareil photo pour la numérisation de votre pièce d'identité et le contrôle facial KYC."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) à utiliser Face ID ou Touch ID pour une connexion sécurisée."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "380035ec-a5b8-429b-9864-f4fc6646a77c"
      },
      "googleAndroidClientId": "89298741090-t1pj2dlpmom5hne9c19cp3scqg84ke7b.apps.googleusercontent.com"
    }
  }
}