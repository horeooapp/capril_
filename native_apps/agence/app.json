{
  "expo": {
    "name": "Qapril Agences Agr\u00e9\u00e9es",
    "slug": "agence",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "../proprietaire/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../proprietaire/assets/splash_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2A44"
    },
    "scheme": "qaprilagence",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/edbe7064-bfd4-4162-99a6-d2c731f1f959",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ci.qapril.agence",
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "../proprietaire/assets/logo-qapril.png",
        "backgroundColor": "#1F2A44"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "versionCode": 36
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) \u00e0 utiliser Face ID ou Touch ID pour une connexion s\u00e9curis\u00e9e."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "edbe7064-bfd4-4162-99a6-d2c731f1f959"
      }
    }
  }
}