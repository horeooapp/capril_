{
  "expo": {
    "name": "Qapril Proprietaires",
    "slug": "proprietaire",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "scheme": "qaprilproprietaire",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/edbe7064-bfd4-4162-99a6-d2c731f1f959",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ci.qapril.proprietaire",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-qapril.png",
        "backgroundColor": "#064E3B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 17
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser $(PRODUCT_NAME) à accéder à vos photos pour la numérisation de vos documents d'identité.",
          "cameraPermission": "Autoriser $(PRODUCT_NAME) à utiliser l'appareil photo pour la numérisation de votre pièce d'identité et le contrôle facial KYC."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) \u00e0 utiliser Face ID ou Touch ID pour une connexion s\u00e9curis\u00e9e."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "edbe7064-bfd4-4162-99a6-d2c731f1f959"
      },
      "googleAndroidClientId": "89298741090-t1pj2dlpmom5hne9c19cp3scqg84ke7b.apps.googleusercontent.com"
    }
  }
}