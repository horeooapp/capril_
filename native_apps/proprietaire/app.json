{
  "expo": {
    "name": "Qapril Proprietaires",
    "slug": "proprietaire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ci.qapril.proprietaire",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-qapril.png",
        "backgroundColor": "#064E3B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) à utiliser Face ID ou Touch ID pour une connexion sécurisée."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "edbe7064-bfd4-4162-99a6-d2c731f1f959"
      }
    }
  }
}
