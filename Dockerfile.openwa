# ──────────────────────────────────────────────────────────────────
# QAPRIL — Dockerfile.openwa
# Passerelle WhatsApp avec QR Code Web
# Fix v4.76+ : chrome-wrapper.sh injecte --no-sandbox sans chromiumArgs
# ──────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# Installation Chromium + polices
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-freefont-ttf \
    fonts-noto \
    fonts-liberation \
    ca-certificates \
    dumb-init \
    curl \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# ── Wrapper Chrome ─────────────────────────────────────────────────
# @open-wa/wa-automate v4.76+ refuse les chromiumArgs en mode MD.
# Ce wrapper injecte --no-sandbox de façon transparente via executablePath.
COPY openwa-server/chrome-wrapper.sh /usr/local/bin/chrome-wrapper
RUN chmod +x /usr/local/bin/chrome-wrapper

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chrome-wrapper \
    CHROME_PATH=/usr/bin/chromium \
    CHROME_WRAPPER=/usr/local/bin/chrome-wrapper \
    NODE_OPTIONS="--max-old-space-size=512"

WORKDIR /app

# Dépendances Node
COPY openwa-server/package.json ./
RUN npm install --no-audit --no-fund

# Code serveur
COPY openwa-server/server.js ./

# Dossier session persistant
RUN mkdir -p /app/session

EXPOSE 8085

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8085/status || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
