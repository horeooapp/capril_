# ──────────────────────────────────────────────────────────────────
# QAPRIL — Dockerfile.openwa (WhatsApp Automation Gateway)
# Node 22 LTS + Chromium + Installation locale (évite le bug npm edgesOut)
# ──────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# Installation des dépendances système Chromium
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-freefont-ttf \
    ca-certificates \
    dumb-init \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium

WORKDIR /app

# Installation locale avec package.json pour un arbre de dépendances 100% propre
RUN npm init -y && \
    npm install --no-audit --no-fund @open-wa/wa-automate

EXPOSE 8085

ENTRYPOINT ["dumb-init", "--"]

CMD ["npx", "@open-wa/wa-automate", "--port", "8085", "--api-key", "qapril_wa_secret_2026", "--use-chrome", "--in-docker", "--qr-timeout", "0"]
