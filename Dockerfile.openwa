# ──────────────────────────────────────────────────────────────────
# QAPRIL — Dockerfile.openwa (Passerelle WhatsApp avec QR Code Web)
# Node 22 LTS + Chromium + Serveur Express avec QR Code dynamique
# ──────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim

# Installation des dépendances système Chromium
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-freefont-ttf \
    ca-certificates \
    dumb-init \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium

WORKDIR /app

# Installation des dépendances du serveur OpenWA
COPY openwa-server/package.json ./
RUN npm install --no-audit --no-fund

# Copie du code serveur
COPY openwa-server/server.js ./

# Dossier de session permanent
RUN mkdir -p /app/session

EXPOSE 8085

ENTRYPOINT ["dumb-init", "--"]

CMD ["node", "server.js"]
