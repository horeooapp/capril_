  SOUMIS_API
  EN_ATTENTE_VALIDATION
  ACTIF
  REJETE
}

enum OperateurNiveau {
  N1
  N2
  N3
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  BANNED
  PENDING_PROFILE
  PENDING
  INVITED
}

enum VaultStatus {
  A_TRANSFERER
