{
  "expo": {
    "name": "Qapril mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2B6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qapril.app"
    },
    "android": {
      "package": "com.qapril.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D2B6E",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a525d2b9-89c8-4cfb-be14-141c90123773"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
