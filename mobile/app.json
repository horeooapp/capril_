{
  "expo": {
    "name": "Qapril",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-qapril.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-qapril.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.qapril.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo-qapril.png",
        "backgroundImage": "./assets/logo-qapril.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a525d2b9-89c8-4cfb-be14-141c90123773"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
